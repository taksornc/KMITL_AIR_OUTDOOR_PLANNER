# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่า (ห้ามอัป .env ขึ้น GitHub/Drive)
# ขอ key ฟรี: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# รุ่นที่ใช้ (ถ้าขึ้นว่าไม่พบโมเดล ให้เปลี่ยนรุ่น)
GEMINI_MODEL=gemini-3.6-flash
# รุ่นสำรองเมื่อรุ่นหลักไม่ว่าง (คั่นด้วย ,)
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,auto
# ระดับการคิดของโมเดล: minimal (เร็วสุด) | low | medium | high | off (ค่าเริ่มต้นของโมเดล)
GEMINI_THINKING=low
# ใช้ค่าฝุ่นจากเซนเซอร์ Smart Pole ใน สจล. (false = ใช้สถานีกรมควบคุมมลพิษแทน)
USE_SMARTPOLE=true

# อีเมลเตือนก่อนกิจกรรม 1 ชม. (Gmail: เปิด 2-Step Verification แล้วสร้าง App Password)
EMAIL_REMINDER=false
SMTP_USER=yourname@gmail.com
SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx
